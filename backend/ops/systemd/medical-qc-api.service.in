[Unit]
Description=Medical report QC api
After=network.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@PROJECT@/backend
EnvironmentFile=@PROJECT@/backend/.env
Environment=TZ=Asia/Shanghai
Environment=INSTANCE_ID=api
Environment=APP_LOG_DIR=@PROJECT@/var/logs
UMask=0077
ExecStart=@BUSINESS_PYTHON@ -m uvicorn app.main:app --host 0.0.0.0 --port 5100 --workers 1
TimeoutStartSec=180
TimeoutStopSec=60
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

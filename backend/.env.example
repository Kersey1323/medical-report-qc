# Copy to backend/.env (chmod600). Never put secrets into VITE_* variables.
DATABASE_URL=mysql+pymysql://medical_qc_app:CHANGE_ME@127.0.0.1:3306/medical_report_qc?charset=utf8mb4
TEST_MYSQL_URL=mysql+pymysql://medical_qc_app:CHANGE_ME@127.0.0.1:3306/medical_qc_test_local?charset=utf8mb4
REDIS_BROKER_URL=redis://127.0.0.1:6379/8
REDIS_URL=redis://127.0.0.1:6379/9
REDIS_PREFIX=medical_qc:
MODEL_SERVICE_URL=http://127.0.0.1:5555
MODEL_AUTH_ENABLED=false
MODEL_SERVICE_TOKEN=
RETRIEVAL_SERVICE_URL=http://127.0.0.1:8102
VAR_DIR=/mnt/mydrive/project/medical-report-qc/var
APP_LOG_DIR=/mnt/mydrive/project/medical-report-qc/var/logs
INSTANCE_ID=local
JUDGE_API_KEY=
TEACHER_API_KEY=
LOCALIZER_API_KEY=
# Historical vector digest is unknown. Default fails closed; enable only after local verification.
ALLOW_UNKNOWN_EMBEDDING_PROVENANCE=false
